# Copy to .env, fill in real values, and `chmod 600 .env` in production
# (see docs/DEPLOYMENT.md and docs/SECURITY.md). Every field below has a
# safe default in src/config/env.ts if omitted; this file documents what
# each one does and shows the values a production deploy typically needs.

# development | test | production
NODE_ENV=production

# Fastify HTTP server. Only bind 0.0.0.0 if you understand the exposure -
# for a single-host deploy, keep 127.0.0.1 and put a reverse proxy in
# front of it (see docs/DEPLOYMENT.md).
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
# true only if a reverse proxy (nginx/caddy) terminates TLS in front of
# this process; makes Fastify trust X-Forwarded-* for request logging.
TRUST_PROXY=false

# SQLite database file. The parent directory is created automatically if
# missing. Back this path up regularly - see deploy/scripts/backup.sh and
# docs/RUNBOOKS/backup-restore.md.
DB_PATH=./data/power-node-01.sqlite

# --- Inference engine -------------------------------------------------
# 'mock'      : spawns the bundled deterministic dev/test engine as a
#               child process of this one. Use for local development and
#               in CI. Never use in production.
# 'llama-cpp' : connects to an already-running llama.cpp server (started
#               and supervised independently, e.g. its own systemd unit -
#               see docs/DEPLOYMENT.md). This process only health-checks
#               it; it never spawns or kills it.
ENGINE_MODE=mock

# The engine must always be reachable only on 127.0.0.1 - never change
# ENGINE_HOST. ENGINE_START_PORT is where EITHER the mock engine (spawned
# by this process) OR your already-running llama.cpp server (in
# 'llama-cpp' mode) listens.
ENGINE_HOST=127.0.0.1
ENGINE_START_PORT=8090

# How long to wait for the engine to report healthy at startup before
# giving up (the app still starts; /ready will report engine: false and
# retry in the background - see ENGINE_HEALTH_POLL_INTERVAL_MS).
ENGINE_STARTUP_TIMEOUT_MS=10000
# 'mock' mode only: bounded crash-restart policy for the child process.
ENGINE_MAX_RESTARTS=5
ENGINE_RESTART_WINDOW_MS=60000
# 'llama-cpp' mode only: how often to re-poll GET /health on the external
# engine, since a crash/restart there produces no signal this process can
# otherwise observe.
ENGINE_HEALTH_POLL_INTERVAL_MS=5000

# 'llama-cpp' mode only: sent as the `model` field of the OpenAI-
# compatible chat completion request, and the per-request timeout for
# that call (connect + full response).
ENGINE_MODEL_NAME=local-model
ENGINE_REQUEST_TIMEOUT_MS=30000

# --- Request limits -----------------------------------------------------
MAX_PROMPT_LENGTH=8000
MAX_TOKENS_LIMIT=2048

# --- Optional API authentication ----------------------------------------
# Off by default. When enabled, POST /generate and every /runs* route
# require `Authorization: Bearer <API_AUTH_KEY>`. GET /health, /ready, and
# /internal/health stay open for infra health checks. The bundled
# monitoring console has no login UI and cannot authenticate itself - see
# docs/SECURITY.md before enabling this on a deploy that also uses the
# console. Generate a key with: openssl rand -hex 32
API_AUTH_ENABLED=false
API_AUTH_KEY=
