# Fastify HTTP server
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# SQLite
DB_PATH=./data/power-node-01.sqlite

# Local inference engine (must bind to 127.0.0.1 only)
ENGINE_HOST=127.0.0.1
ENGINE_START_PORT=8090
ENGINE_STARTUP_TIMEOUT_MS=10000
ENGINE_MAX_RESTARTS=5
ENGINE_RESTART_WINDOW_MS=60000

# Generation limits (bounded resources)
MAX_PROMPT_LENGTH=8000
MAX_TOKENS_LIMIT=2048
